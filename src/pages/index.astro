---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
import WritingCard from "../components/WritingCard.astro";
import profile from "../data/profile.json";
import { getPublishedWriting, sortFeaturedWriting } from "../lib/writing";

const writing = await getPublishedWriting();
const featuredWriting = sortFeaturedWriting(writing).slice(0, 3);
const pinnedProjects = profile.projects.filter((project) => project.pinned).slice(0, 2);
const companyLogos = [
  {
    name: "Wysa",
    detail: "Global Mental Health AI",
    logoSrc: "/images/logos/optimized/wysa.png",
    width: 620,
    height: 202
  },
  {
    name: "WeWork Labs",
    detail: "Workplace platform",
    logoSrc: "/images/logos/optimized/wework-labs.png",
    width: 620,
    height: 100
  },
  {
    name: "Marriott",
    detail: "Hotels & hospitality",
    logoSrc: "/images/logos/optimized/marriott.svg",
    width: 389,
    height: 305
  },
  {
    name: "MOHT",
    detail: "Singapore health transformation",
    logoSrc: "/images/logos/optimized/moht.png",
    width: 760,
    height: 161
  },
  {
    name: "NHS",
    detail: "UK Healthcare System",
    logoSrc: "/images/logos/optimized/nhs.svg",
    width: 371,
    height: 150
  }
];
const companyLogoLoop = [...companyLogos, ...companyLogos];
---

<BaseLayout>
  <Header />
  <main id="main-content" class="page" tabindex="-1">
    <section class="hero-editorial" aria-labelledby="hero-title">
      <figure class="hero-image" data-reveal="hero">
        <picture>
          <source media="(max-width: 760px)" srcset="/images/anand-hero-portrait.png" />
          <img
            src="/images/anand-hero-wide.png"
            alt="A person seated at a computer in a green valley facing nested translucent screens."
            width="1672"
            height="941"
            loading="eager"
            decoding="async"
          />
        </picture>
      </figure>

      <div class="hero-copy" data-reveal="hero">
        <p class="eyebrow">Portfolio / applied AI systems</p>
        <h1 id="hero-title" class="hero-title">
          Anand <span>Gupta</span>
        </h1>
        <div class="hero-lower">
          <p class="hero-lede">
            <span class="sr-only">{profile.headline}</span>
            <span
              id="hero-headline-motion"
              class="typewriter"
              data-typewriter
              data-phrases={JSON.stringify(profile.headlinePhrases)}
              aria-hidden="true"
            >
              {profile.headlinePhrases[0]}
            </span>
          </p>
          <p class="hero-bio">{profile.bio}</p>
          <div class="action-row">
            <a class="button primary" href={`mailto:${profile.email}`}>{profile.cta.primaryLabel}</a>
            <a class="button" href="/blog/" data-astro-prefetch>{profile.cta.secondaryLabel}</a>
          </div>
        </div>
      </div>

      <aside class="identity-strip" aria-label="About Anand" data-reveal>
        {
          profile.identityRows.map((row) => (
            <div class="identity-row">
              <p class="card-kicker">{row.label}</p>
              <p>{row.value}</p>
            </div>
          ))
        }
      </aside>
    </section>

    <section class="logo-section" aria-labelledby="companies-title">
      <div class="section-header compact" data-reveal>
        <div>
          <h2 id="companies-title" class="section-title">Delivered for</h2>
        </div>
      </div>
      <div class="logo-marquee" aria-label="Companies Anand has worked with" data-reveal>
        <div class="logo-track">
          {
            companyLogoLoop.map((company) => (
              <article class={`logo-card ${company.logoSrc ? "has-logo" : ""}`}>
                {
                  company.logoSrc ? (
                    <img
                      class={`logo-image logo-${company.name.toLowerCase().replaceAll(" ", "-")}`}
                      src={company.logoSrc}
                      alt={`${company.name} logo`}
                      width={company.width}
                      height={company.height}
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <p class={`logo-mark logo-${company.name.toLowerCase().replaceAll(" ", "-")}`}>
                      {company.name}
                    </p>
                  )
                }
                <p>{company.detail}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="writing-title">
      <div class="section-header" data-reveal>
        <div>
          <p class="section-label">Recent writing</p>
          <h2 id="writing-title" class="section-title">Writing worth opening</h2>
          <p class="section-copy">
            A few trails into how I think: data that tells on itself, models in messy settings, and the product questions around both.
          </p>
        </div>
        <a class="button" href="/blog/" data-astro-prefetch>All blogs</a>
      </div>
      <div class="writing-list">
        {featuredWriting.map((entry) => <WritingCard entry={entry} />)}
      </div>
    </section>

    <section class="section" aria-labelledby="code-title">
      <div class="section-header" data-reveal>
        <div>
          <p class="section-label">Selected code</p>
          <h2 id="code-title" class="section-title">Proof in public</h2>
          <p class="section-copy">
            Repos and experiments that make the work more concrete than a paragraph can.
          </p>
        </div>
        <a class="button" href="/code/" data-astro-prefetch>All code</a>
      </div>
      <div class="project-grid">
        {pinnedProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </main>
  <Footer />
  <script>
    let teardownTypewriter = () => {};

    const initTypewriter = () => {
      teardownTypewriter();

      const typewriter = document.querySelector("[data-typewriter]");

      if (!(typewriter instanceof HTMLElement)) {
        teardownTypewriter = () => {};
        return;
      }

      const phrases = JSON.parse(typewriter.dataset.phrases ?? "[]") as string[];
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let phraseIndex = 0;
      let charIndex = phrases[0]?.length ?? 0;
      let deleting = true;
      let timeout = 0;

      const clearTick = () => {
        window.clearTimeout(timeout);
        timeout = 0;
      };

      const schedule = (delay: number) => {
        clearTick();
        timeout = window.setTimeout(tick, delay);
      };

      const tick = () => {
        if (reduceMotion.matches) return;

        const phrase = phrases[phraseIndex];
        typewriter.textContent = phrase.slice(0, charIndex);

        if (!deleting && charIndex === phrase.length) {
          deleting = true;
          schedule(1300);
          return;
        }

        if (deleting && charIndex === 0) {
          deleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
          schedule(260);
          return;
        }

        charIndex += deleting ? -1 : 1;
        schedule(deleting ? 42 : 72);
      };

      const syncMotionPreference = () => {
        clearTick();
        typewriter.textContent = phrases[0] ?? "";
        phraseIndex = 0;
        charIndex = phrases[0]?.length ?? 0;
        deleting = true;

        if (phrases.length > 1 && !reduceMotion.matches) {
          schedule(900);
        }
      };

      teardownTypewriter = () => {
        clearTick();
        reduceMotion.removeEventListener("change", syncMotionPreference);
      };

      reduceMotion.addEventListener("change", syncMotionPreference);
      syncMotionPreference();
    };

    if (!document.documentElement.dataset.typewriterBound) {
      document.documentElement.dataset.typewriterBound = "true";
      document.addEventListener("astro:page-load", initTypewriter);
      document.addEventListener("astro:before-preparation", () => teardownTypewriter());
    }

    initTypewriter();
  </script>
</BaseLayout>
