---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { formatFullDate } from "../../lib/writing";

export async function getStaticPaths() {
  const entries = await getCollection("writing", ({ data }) => {
    return !data.draft && !data.externalUrl;
  });

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  path={`/blog/${entry.id}/`}
  image={entry.data.heroImage}
  type="article"
  publishedTime={entry.data.pubDate}
  modifiedTime={entry.data.updatedDate ?? entry.data.pubDate}
>
  <Header />
  <main id="main-content" class="page narrow reading-panel" tabindex="-1">
    <article>
      <header class="article-header">
        <p class="meta-line">
          <time datetime={entry.data.pubDate.toISOString()}>{formatFullDate(entry.data.pubDate)}</time>
          <span aria-hidden="true"> / </span>
          <span>{entry.data.source}</span>
        </p>
        <h1 class="article-title">{entry.data.title}</h1>
        <p class="article-description">{entry.data.description}</p>
        {
          entry.data.tags.length > 0 && (
            <div class="tag-row" style="margin-top: 18px;">
              {entry.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )
        }
        {
          entry.data.heroImage && (
            <figure class="article-hero">
              <Image
                src={entry.data.heroImage}
                alt={entry.data.heroAlt ?? ""}
                widths={[720, 1080, 1440]}
                sizes="(min-width: 760px) 760px, 100vw"
              />
              {entry.data.heroAlt && <figcaption>{entry.data.heroAlt}</figcaption>}
            </figure>
          )
        }
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
