---
interface Props {
  source: string;
}

const { source } = Astro.props;
const normalized = source.toLowerCase();
const kind = normalized.includes("medium")
  ? "medium"
  : normalized.includes("substack")
    ? "substack"
    : "site";

const label =
  kind === "medium" ? "Medium" : kind === "substack" ? "Substack" : source || "Blog";
---

<span class={`source-logo ${kind}`} aria-label={label} title={label}>
  {
    kind === "medium" ? (
      <svg viewBox="0 0 1043.63 592.71" aria-hidden="true">
        <path d="M588.67 296.36c0 163.67-131.78 296.35-294.33 296.35S0 460.03 0 296.36 131.78 0 294.34 0s294.33 132.69 294.33 296.36" />
        <path d="M911.56 296.36c0 154.06-65.89 278.98-147.18 278.98S617.2 450.42 617.2 296.36 683.09 17.38 764.38 17.38s147.18 124.92 147.18 278.98" />
        <path d="M1043.63 296.36c0 138.02-23.18 249.93-51.78 249.93s-51.78-111.91-51.78-249.93S963.25 46.43 991.85 46.43s51.78 111.91 51.78 249.93" />
      </svg>
    ) : kind === "substack" ? (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 3h16v2.8H4V3Zm0 5.1h16v2.8H4V8.1Zm0 5.1h16V22l-8-4.45L4 22v-8.8Z" />
      </svg>
    ) : (
      <span aria-hidden="true">AG</span>
    )
  }
</span>
